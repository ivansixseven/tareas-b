# 86. Leer 10 números y determinar cuántos son pares y cuántos impares. Usar: Para + Si.
import sys


def leer(msg):
    while True:
        try:
            return int(input(msg))
        except ValueError:
            print("Ingresa un número entero.")


def main():
    pares = impares = 0
    for i in range(10):
        n = leer(f"Número {i + 1}: ")
        if n % 2 == 0:
            pares += 1
        else:
            impares += 1
    print(f"Pares: {pares} | Impares: {impares}")


if __name__ == "__main__":
    main()
    sys.exit(0)
